<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cobranca_envio_list" model="ir.ui.view">
        <field name="name">maisfibra.cobranca.envio.list</field>
        <field name="model">maisfibra.cobranca.envio</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-success="status == 'sucesso'" decoration-danger="status == 'falha'">
                <field name="data_envio"/>
                <field name="partner_id"/>
                <field name="cobranca_id"/>
                <field name="nota_fiscal_id"/>
                <field name="tipo_documento"/>
                <field name="canal"/>
                <field name="tipo_disparo"/>
                <field name="destinatario"/>
                <field name="status" widget="badge" decoration-success="status == 'sucesso'" decoration-danger="status == 'falha'" decoration-warning="status == 'ignorado'"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="view_cobranca_envio_form" model="ir.ui.view">
        <field name="name">maisfibra.cobranca.envio.form</field>
        <field name="model">maisfibra.cobranca.envio</field>
        <field name="arch" type="xml">
            <form string="Registro de Envio" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="data_envio"/>
                        <field name="partner_id"/>
                        <field name="cobranca_id"/>
                        <field name="nota_fiscal_id"/>
                        <field name="tipo_documento"/>
                        <field name="canal"/>
                        <field name="tipo_disparo"/>
                        <field name="destinatario"/>
                        <field name="status"/>
                        <field name="external_id"/>
                        <field name="user_id"/>
                        <field name="mensagem_erro"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cobranca_envio_search" model="ir.ui.view">
        <field name="name">maisfibra.cobranca.envio.search</field>
        <field name="model">maisfibra.cobranca.envio</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="destinatario"/>
                <filter name="sucesso" string="Sucesso" domain="[('status', '=', 'sucesso')]"/>
                <filter name="falha" string="Falha" domain="[('status', '=', 'falha')]"/>
                <filter name="email" string="E-mail" domain="[('canal', '=', 'email')]"/>
                <filter name="whatsapp" string="WhatsApp" domain="[('canal', '=', 'whatsapp')]"/>
            </search>
        </field>
    </record>

    <record id="action_cobranca_envios" model="ir.actions.act_window">
        <field name="name">Histórico de Envios</field>
        <field name="res_model">maisfibra.cobranca.envio</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
