<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_pagamento_page" name="Portal de Pagamento MaisFibra">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Mais Fibra — Boleto <t t-out="cob.name"/></title>
                <style>
                    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f3f4f6; margin: 0; padding: 24px 12px; color: #111827; }
                    .card { max-width: 720px; margin: 0 auto; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,.08); overflow: hidden; }
                    .header { background: linear-gradient(135deg, #0b3b8c, #1d4ed8); color: #fff; padding: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
                    .header h1 { margin: 0; font-size: 20px; }
                    .badge { padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; text-transform: uppercase; background: rgba(255,255,255,.2); }
                    .badge-paga { background: #16a34a; }
                    .badge-vencida { background: #dc2626; }
                    .content { padding: 24px; }
                    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 20px; }
                    .box { background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px 14px; }
                    .label { font-size: 11px; text-transform: uppercase; color: #6b7280; margin-bottom: 4px; }
                    .val { font-size: 16px; font-weight: 600; color: #111827; }
                    .copy-box { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 14px; margin-bottom: 16px; }
                    .mono { font-family: monospace; word-break: break-all; font-size: 13px; margin: 6px 0 10px 0; }
                    .btn { display: inline-block; padding: 10px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; border: none; cursor: pointer; font-size: 14px; margin-right: 8px; margin-top: 6px; }
                    .btn-primary { background: #1d4ed8; color: #fff; }
                    .btn-success { background: #15803d; color: #fff; }
                    .btn-outline { background: #fff; color: #1d4ed8; border: 1px solid #1d4ed8; }
                    .footer { text-align: center; font-size: 12px; color: #6b7280; padding: 16px 24px; border-top: 1px solid #e5e7eb; }
                </style>
            </head>
            <body>
                <div class="card">
                    <div class="header">
                        <div>
                            <h1><t t-out="cob.company_id.name or 'Mais Fibra'"/> — Portal Financeiro</h1>
                            <div style="font-size: 13px; opacity: .9;">Documento <t t-out="cob.name"/> · Ref. <t t-out="cob.competencia"/></div>
                        </div>
                        <span t-attf-class="badge #{'badge-paga' if cob.state == 'paga' else ('badge-vencida' if cob.state == 'vencida' else '')}">
                            <t t-out="dict(cob._fields['state'].selection).get(cob.state, cob.state)"/>
                        </span>
                    </div>
                    <div class="content">
                        <div class="grid">
                            <div class="box">
                                <div class="label">Cliente / Pagador</div>
                                <div class="val"><t t-out="cob.partner_id.name"/></div>
                            </div>
                            <div class="box">
                                <div class="label">Vencimento</div>
                                <div class="val"><t t-out="cob.data_vencimento"/></div>
                            </div>
                            <div class="box">
                                <div class="label">Valor</div>
                                <div class="val">R$ <t t-out="'%.2f' % (cob.valor_liquido or cob.valor_original)"/></div>
                            </div>
                        </div>

                        <div t-if="cob.linha_digitavel" class="copy-box">
                            <div class="label">Linha Digitável do Boleto</div>
                            <div id="mf_linha" class="mono"><t t-out="cob.linha_digitavel"/></div>
                            <button type="button" class="btn btn-outline" onclick="navigator.clipboard.writeText(document.getElementById('mf_linha').innerText)">Copiar Linha Digitável</button>
                        </div>

                        <div t-if="cob.pix_copia_cola" class="copy-box" style="background:#f0fdf4;border-color:#bbf7d0;">
                            <div class="label">PIX Copia e Cola</div>
                            <div id="mf_pix" class="mono"><t t-out="cob.pix_copia_cola"/></div>
                            <button type="button" class="btn btn-success" onclick="navigator.clipboard.writeText(document.getElementById('mf_pix').innerText)">Copiar Código PIX</button>
                        </div>

                        <div style="margin-top: 20px;">
                            <a t-attf-href="/maisfibra/pagamento/#{token}/pdf" class="btn btn-primary" target="_blank">Baixar Boleto (PDF)</a>
                            <t t-if="nf">
                                <a t-attf-href="/maisfibra/pagamento/#{token}/nf/pdf" class="btn btn-outline" target="_blank">Nota Fiscal (PDF)</a>
                                <a t-attf-href="/maisfibra/pagamento/#{token}/nf/xml" class="btn btn-outline" target="_blank">Nota Fiscal (XML)</a>
                            </t>
                        </div>
                    </div>
                    <div class="footer">
                        Emissão segura Mais Fibra · Nosso Número: <t t-out="cob.nosso_numero or '-'"/>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
