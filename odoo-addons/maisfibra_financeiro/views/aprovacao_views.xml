<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_mf_aprovacao" model="ir.ui.view">
        <field name="name">account.move.form.mf.aprovacao</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="mf_aprovacao_ativa" invisible="1"/>
                <button name="action_mf_solicitar_aprovacao" type="object" string="Solicitar aprovação"
                        class="btn-primary" icon="fa-paper-plane"
                        invisible="not mf_aprovacao_ativa or state != 'draft' or mf_aprovacao_state in ('pendente', 'aprovado')"/>
                <button name="action_mf_aprovar" type="object" string="Aprovar" class="btn-success" icon="fa-check"
                        invisible="not mf_aprovacao_ativa or mf_aprovacao_state != 'pendente'"/>
                <button name="action_mf_recusar" type="object" string="Recusar" icon="fa-times"
                        invisible="not mf_aprovacao_ativa or mf_aprovacao_state != 'pendente'"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="not mf_aprovacao_ativa or mf_aprovacao_state != 'pendente'">
                    Aguardando aprovação de <field name="mf_nivel_aprovacao" readonly="1" class="fw-bold"/>.
                </div>
                <div class="alert alert-danger mb-0" role="alert"
                     invisible="not mf_aprovacao_ativa or mf_aprovacao_state != 'recusado'">
                    Recusada: <field name="mf_motivo_recusa" readonly="1"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Aprovação" name="mf_aprovacao" invisible="not mf_aprovacao_ativa">
                    <group>
                        <field name="mf_nivel_aprovacao"/>
                        <field name="mf_aprovacao_state"/>
                        <field name="mf_aprovado_por"/>
                        <field name="mf_aprovado_em"/>
                        <field name="mf_valor_aprovado"/>
                        <field name="mf_motivo_recusa" readonly="mf_aprovacao_state != 'pendente'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Contas aguardando aprovação -->
    <record id="action_contas_aprovar" model="ir.actions.act_window">
        <field name="name">Contas a Aprovar</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('mf_aprovacao_state', '=', 'pendente')]</field>
        <field name="context">{'default_move_type': 'in_invoice'}</field>
        <field name="help" type="html"><p>Contas a pagar aguardando a sua alçada de aprovação.</p></field>
    </record>

    <!-- Agenda de pagamentos -->
    <record id="view_agenda_pagamentos_calendar" model="ir.ui.view">
        <field name="name">account.move.calendar.agenda</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <calendar string="Agenda de pagamentos" date_start="invoice_date_due" color="partner_id"
                      mode="month" quick_create="0" create="0">
                <field name="partner_id"/>
                <field name="amount_residual"/>
                <field name="payment_state"/>
            </calendar>
        </field>
    </record>
    <record id="view_agenda_pagamentos_search" model="ir.ui.view">
        <field name="name">account.move.search.agenda</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="esta_semana" string="Vence nos próximos 7 dias"
                        domain="[('invoice_date_due', '&gt;=', context_today().strftime('%Y-%m-%d')), ('invoice_date_due', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="atrasados" string="Atrasados"
                        domain="[('invoice_date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="g_fornecedor" string="Fornecedor" context="{'group_by': 'partner_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_agenda_pagamentos" model="ir.actions.act_window">
        <field name="name">Agenda de Pagamentos</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_agenda_pagamentos_search"/>
        <field name="domain">[('move_type', 'in', ('in_invoice', 'in_refund')), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'calendar', 'view_id': ref('view_agenda_pagamentos_calendar')}), (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_in_invoice_bill_tree')})]"/>
    </record>

    <menuitem id="menu_mf_pagar" name="MaisFibra" parent="account.menu_finance_payables" sequence="90"/>
    <menuitem id="menu_contas_aprovar" name="Contas a Aprovar" parent="menu_mf_pagar" action="action_contas_aprovar" sequence="10"/>
    <menuitem id="menu_agenda_pagamentos" name="Agenda de Pagamentos" parent="menu_mf_pagar" action="action_agenda_pagamentos" sequence="20"/>

    <!-- Configurações -->
    <record id="res_config_settings_view_form_fin" model="ir.ui.view">
        <field name="name">res.config.settings.form.financeiro</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="maisfibra_crm.res_config_settings_view_form_mf"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='maisfibra_crm']" position="inside">
                <block title="Financeiro: aprovação de contas a pagar">
                    <setting string="Exigir aprovação" help="Conta a pagar só pode ser lançada depois de aprovada pela alçada. Defina quem é Gerente, Diretor e CFO em Usuários (Faturamento > Aprovador de pagamentos).">
                        <field name="mf_aprovacao_ativa"/>
                        <div class="content-group" invisible="not mf_aprovacao_ativa">
                            <div class="row mt8"><label for="mf_limite_gerente" class="col-lg-4 o_light_label"/><field name="mf_limite_gerente"/></div>
                            <div class="row"><label for="mf_limite_diretor" class="col-lg-4 o_light_label"/><field name="mf_limite_diretor"/></div>
                            <div class="text-muted">Acima do limite do Diretor, aprova o CFO.</div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
