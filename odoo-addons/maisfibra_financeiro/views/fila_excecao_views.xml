<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fila_excecao_list" model="ir.ui.view">
        <field name="name">maisfibra.fila.excecao.list</field>
        <field name="model">maisfibra.fila.excecao</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'pendente'" decoration-success="state == 'resolvida'" decoration-muted="state == 'descartada'">
                <field name="name"/>
                <field name="tipo"/>
                <field name="partner_id"/>
                <field name="cobranca_id"/>
                <field name="nota_fiscal_id"/>
                <field name="tentativas"/>
                <field name="max_tentativas"/>
                <field name="proxima_tentativa"/>
                <field name="state" widget="badge" decoration-danger="state == 'pendente'" decoration-success="state == 'resolvida'" decoration-warning="state == 'reprocessando'"/>
                <field name="motivo_erro"/>
                <button name="action_reprocessar" string="Reprocessar" type="object" icon="fa-refresh" class="btn-primary"
                        invisible="state in ('resolvida', 'descartada')"/>
            </list>
        </field>
    </record>

    <record id="view_fila_excecao_form" model="ir.ui.view">
        <field name="name">maisfibra.fila.excecao.form</field>
        <field name="model">maisfibra.fila.excecao</field>
        <field name="arch" type="xml">
            <form string="Exceção Operacional">
                <header>
                    <button name="action_reprocessar" string="Reprocessar Agora" type="object" class="btn-primary"
                            invisible="state in ('resolvida', 'descartada')"/>
                    <button name="action_descartar" string="Descartar Exceção" type="object" class="btn-secondary"
                            groups="maisfibra_financeiro.group_gestor_financeiro"
                            invisible="state in ('resolvida', 'descartada')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pendente,reprocessando,resolvida,descartada"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="partner_id"/>
                            <field name="cobranca_id"/>
                            <field name="nota_fiscal_id"/>
                            <field name="identificador_externo"/>
                        </group>
                        <group>
                            <field name="tentativas"/>
                            <field name="max_tentativas"/>
                            <field name="proxima_tentativa"/>
                            <field name="resolvido_por"/>
                            <field name="resolvido_em"/>
                        </group>
                    </group>
                    <group string="Motivo do Erro"><field name="motivo_erro" nolabel="1" readonly="1"/></group>
                    <group string="Payload Sanitizado"><field name="payload_json" nolabel="1" readonly="1"/></group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fila_excecao_search" model="ir.ui.view">
        <field name="name">maisfibra.fila.excecao.search</field>
        <field name="model">maisfibra.fila.excecao</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="pendentes" string="Pendentes" domain="[('state', 'in', ('pendente', 'reprocessando'))]"/>
                <filter name="resolvidas" string="Resolvidas" domain="[('state', '=', 'resolvida')]"/>
                <filter name="g_tipo" string="Tipo" context="{'group_by': 'tipo'}"/>
            </search>
        </field>
    </record>

    <record id="action_fila_excecoes" model="ir.actions.act_window">
        <field name="name">Fila de Exceções</field>
        <field name="res_model">maisfibra.fila.excecao</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pendentes': 1}</field>
    </record>
</odoo>
