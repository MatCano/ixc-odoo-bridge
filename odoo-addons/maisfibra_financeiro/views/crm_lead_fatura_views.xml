<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_mf_fatura" model="ir.ui.view">
        <field name="name">crm.lead.form.mf.fatura</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_mf_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="mf_invoice_count == 0 and won_status != 'won'">
                    <field name="mf_invoice_count" widget="statinfo" string="Faturas"/>
                </button>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Faturas" name="mf_faturas" invisible="mf_invoice_count == 0">
                    <group invisible="not mf_cobranca_id">
                        <field name="mf_cobranca_id" readonly="1"/>
                    </group>
                    <field name="mf_invoice_ids" readonly="1">
                        <list>
                            <field name="name" string="Número"/>
                            <field name="invoice_date" string="Emissão"/>
                            <field name="invoice_date_due" string="Vencimento"/>
                            <field name="amount_total" string="Total"/>
                            <field name="state" string="Status" widget="badge"
                                   decoration-success="state == 'posted'"
                                   decoration-muted="state == 'cancel'"/>
                            <field name="payment_state" string="Pagamento" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
