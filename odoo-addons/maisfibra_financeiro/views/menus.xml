              name="Configuração"
              parent="menu_mf_financeiro_app_root"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_mf_app_config_parametros"
              name="Parâmetros Financeiros"
              parent="menu_mf_app_config_grp"
              action="action_mf_financeiro_config"
              sequence="10"
              groups="base.group_system"/>

    <!-- Atalho integrado dentro de Faturamento -->
