              name="Cobranças &amp; Fiscal"
              parent="account.menu_finance"
              sequence="15"/>

    <menuitem id="menu_mf_fin_dashboard"
              name="Painel Financeiro"
              parent="menu_mf_cobrancas_hub"
              action="action_mf_financeiro_dashboard"
              sequence="5"/>

    <menuitem id="menu_mf_cobrancas"
              name="Boletos e Cobranças"
              parent="menu_mf_cobrancas_hub"
