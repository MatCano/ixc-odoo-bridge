              sequence="30"/>

    <menuitem id="menu_mf_gerar_lote"
              name="Gerar Cobranças em Lote"
              parent="menu_mf_cobrancas_hub"
              action="action_cobranca_lote_wizard"
              sequence="40"/>

    <menuitem id="menu_mf_envios"
              name="Histórico de Envios"
              parent="menu_mf_cobrancas_hub"
              action="action_cobranca_envios"
              sequence="50"/>

    <menuitem id="menu_mf_fila_excecoes"
              name="Fila de Exceções"
              parent="menu_mf_cobrancas_hub"
              action="action_fila_excecoes"
              sequence="60"/>

    <menuitem id="menu_mf_integracao_logs"
              name="Logs de Integração"
              parent="menu_mf_cobrancas_hub"
              action="action_integracao_logs"
              sequence="70"/>
</odoo>
