<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form_whatsapp" model="ir.ui.view">
        <field name="name">res.partner.form.whatsapp</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_whatsapp" type="object" class="oe_stat_button"
                        icon="fa-whatsapp" string="Enviar WhatsApp"/>
                <button name="action_view_whatsapp_messages" type="object"
                        class="oe_stat_button" icon="fa-comments">
                    <field name="whatsapp_message_count" widget="statinfo" string="Mensagens"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="domain">[('mf_whatsapp_sync', '=', False)]</field>
    </record>

    <function model="res.partner" name="_mf_cleanup_whatsapp_synced_contacts"/>
</odoo>
