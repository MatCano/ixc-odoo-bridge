<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mf" model="ir.ui.view">
        <field name="name">res.config.settings.form.maisfibra</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="MaisFibra" string="MaisFibra" name="maisfibra_crm">
                    <block title="Integração com o IXC (bridge)">
                        <setting string="Bridge" help="Ex.: http://ixc-odoo-bridge:8000 (endereço interno no Easypanel). Mesmo token da variável BRIDGE_TOKEN do bridge.">
                            <div class="content-group">
                                <div class="row mt8"><label for="mf_bridge_url" class="col-lg-4 o_light_label"/><field name="mf_bridge_url"/></div>
                                <div class="row"><label for="mf_bridge_token" class="col-lg-4 o_light_label"/><field name="mf_bridge_token" password="True"/></div>
                            </div>
                        </setting>
                    </block>
                    <block title="Migração">
                        <setting string="Vínculos antigos com o IXC" help="Copia os IDs do IXC que o bridge antigo gravava como texto na descrição do lead e no contato para os campos novos. Não sobrescreve nada; pode rodar mais de uma vez.">
                            <button name="action_mf_migrar" type="object" string="Migrar agora" class="btn-secondary" icon="fa-exchange"/>
                        </setting>
                    </block>
                    <block title="E-mails automáticos (ligar só depois de configurar o SMTP)">
                        <setting string="Boas-vindas" help="Para contato novo com e-mail. Nunca para contatos vindos do IXC. Template: MaisFibra: Boas-vindas.">
                            <field name="mf_email_boas_vindas"/>
                        </setting>
                        <setting string="Confirmações por estágio" help="Escolha o e-mail no próprio estágio: proposta, contratação, cancelamento.">
                            <field name="mf_email_estagio"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
