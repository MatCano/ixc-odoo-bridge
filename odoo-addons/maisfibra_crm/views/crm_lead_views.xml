<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_mf" model="ir.ui.view">
        <field name="name">crm.lead.form.maisfibra</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_mf_consultar_ixc" type="object" string="Consultar IXC" icon="fa-file-text-o"/>
                <button name="action_mf_consultar_credito" type="object" string="Consultar crédito"
                        icon="fa-search" invisible="not mf_cpf_cnpj"/>
            </xpath>

            <xpath expr="//notebook" position="before">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 px-3 my-2 border rounded bg-light"
                     invisible="type == 'lead' or not active">
                    <field name="mf_can_stage_back" invisible="1"/>
                    <field name="mf_can_stage_next" invisible="1"/>
                    <field name="mf_next_stage_is_won" invisible="1"/>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small fw-semibold text-uppercase">Etapa atual:</span>
                        <span class="badge rounded-pill text-bg-primary px-3 py-2">
                            <field name="mf_stage_name" readonly="1" nolabel="1"/>
                        </span>
                        <span class="text-muted small ms-2" invisible="not mf_can_stage_next">
                            Próxima: <strong class="text-dark"><field name="mf_next_stage_name" readonly="1" nolabel="1"/></strong>
                        </span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button name="action_mf_stage_back"
                                type="object"
                                string="Back"
                                icon="fa-arrow-left"
                                class="btn btn-secondary btn-sm"
                                invisible="not mf_can_stage_back"/>
                        <button name="action_mf_stage_next"
                                type="object"
                                string="Next"
                                icon="fa-arrow-right"
                                class="btn btn-primary btn-sm"
                                invisible="not mf_can_stage_next or mf_next_stage_is_won"/>
                        <button name="action_mf_stage_next"
                                type="object"
                                string="Next (Ganho)"
                                icon="fa-trophy"
                                class="btn btn-success btn-sm"
                                invisible="not mf_can_stage_next or not mf_next_stage_is_won"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Cliente &amp; Instalação" name="mf_instalacao">
                    <group>
                        <group string="Identificação">
                            <field name="mf_cpf_cnpj"/>
                            <field name="mf_origem"/>
                            <field name="mf_canal_venda_id" options="{'no_create': True}"/>
                            <field name="mf_indicado_por_id"/>
                            <field name="mf_concorrente"/>
                        </group>
                        <group string="Endereço de instalação">
                            <field name="mf_condominio_id" options="{'no_create': True}"/>
                            <field name="mf_bloco"/>
                            <field name="mf_apartamento"/>
                            <field name="mf_cep"/>
                            <field name="mf_endereco"/>
                            <field name="mf_numero"/>
                            <field name="mf_complemento"/>
                            <field name="mf_bairro"/>
                            <field name="mf_cidade"/>
                        </group>
                    </group>
                    <group string="Crédito">
                        <field name="mf_credito_status" readonly="1"/>
                        <field name="mf_credito_obs" readonly="1" invisible="not mf_credito_obs"/>
                    </group>
                    <group string="Financeiro e serviço (IXC)">
                        <field name="mf_ixc_status_servico"/>
                        <field name="mf_ixc_faturas_abertas"/>
                        <field name="mf_ixc_faturas_vencidas" decoration-danger="mf_ixc_faturas_vencidas &gt; 0"/>
                        <field name="mf_ixc_valor_aberto"/>
                        <field name="mf_ixc_valor_vencido" decoration-danger="mf_ixc_valor_vencido &gt; 0"/>
                        <field name="mf_ixc_consultado_em"/>
                    </group>
                    <group string="IXC">
                        <field name="mf_stage_code" invisible="1"/>
                        <field name="mf_ixc_contato_id" readonly="1"/>
                        <field name="mf_ixc_cliente_id" readonly="1"/>
                    </group>
                </page>
                <page string="Negociação" name="mf_negociacao"
                      invisible="mf_stage_code not in ('recolher_docs', 'negociacao', 'aguardando_assinatura', 'perdemos')">
                    <group>
                        <field name="mf_plano_id" options="{'no_create': True}"/>
                        <field name="mf_descricao_produto"/>
                        <field name="mf_ixc_negociacao_id" readonly="1"/>
                    </group>
                    <div class="text-muted">
                        Ao mover para <b>Negociação</b>, a negociação é criada no IXC.
                        Ganho → <b>Aguardar Assinatura</b>; perda → <b>Perdemos</b> (vem do IXC automaticamente).
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Busca por CPF/CNPJ, condomínio e IDs do IXC -->
    <record id="crm_lead_search_mf" model="ir.ui.view">
        <field name="name">crm.lead.search.maisfibra</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mf_cpf_cnpj"/>
                <field name="mf_condominio_id"/>
                <field name="mf_ixc_cliente_id"/>
            </xpath>
        </field>
    </record>
</odoo>
