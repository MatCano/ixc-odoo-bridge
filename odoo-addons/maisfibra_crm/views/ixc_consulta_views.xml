<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ixc_consulta_view_form" model="ir.ui.view">
        <field name="name">maisfibra.ixc.consulta.form</field>
        <field name="model">maisfibra.ixc.consulta</field>
        <field name="arch" type="xml">
            <form string="Cliente no IXC" create="0" edit="0">
                <sheet>
                    <div class="oe_title"><h2><field name="titulo"/></h2></div>
                    <group>
                        <group>
                            <field name="ixc_cliente_id"/>
                            <field name="status_servico"/>
                        </group>
                        <group>
                            <field name="valor_aberto"/>
                            <field name="valor_vencido" decoration-danger="valor_vencido &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Faturas" name="faturas">
                            <field name="fatura_ids">
                                <list decoration-danger="vencida" decoration-muted="valor_aberto == 0">
                                    <field name="vencimento"/>
                                    <field name="valor" sum="Total"/>
                                    <field name="valor_aberto" sum="Em aberto"/>
                                    <field name="status"/>
                                    <field name="vencida" optional="hide"/>
                                    <field name="linha_digitavel" optional="show"/>
                                    <field name="ixc_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contratos" name="contratos">
                            <field name="contrato_ids">
                                <list>
                                    <field name="nome"/>
                                    <field name="status"/>
                                    <field name="status_internet"/>
                                    <field name="data_ativacao"/>
                                    <field name="ixc_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button special="cancel" string="Fechar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
