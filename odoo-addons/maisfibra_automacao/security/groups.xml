<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_automacao" model="res.groups.privilege">
        <field name="name">Automação de CRM</field>
    </record>

    <record id="group_automacao_viewer" model="res.groups">
        <field name="name">Visualizador de Automações</field>
        <field name="privilege_id" ref="res_groups_privilege_automacao"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_automacao_editor" model="res.groups">
        <field name="name">Editor de Automações</field>
        <field name="privilege_id" ref="res_groups_privilege_automacao"/>
        <field name="implied_ids" eval="[(4, ref('group_automacao_viewer'))]"/>
    </record>

    <record id="group_automacao_admin" model="res.groups">
        <field name="name">Administrador de Automações</field>
        <field name="privilege_id" ref="res_groups_privilege_automacao"/>
        <field name="implied_ids" eval="[(4, ref('group_automacao_editor'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_automacao_admin'))]"/>
    </record>
</odoo>
