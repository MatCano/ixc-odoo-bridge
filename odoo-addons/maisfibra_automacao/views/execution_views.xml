<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mf_automation_execution_list" model="ir.ui.view">
        <field name="name">mf.automation.execution.list</field>
        <field name="model">mf.automation.execution</field>
        <field name="arch" type="xml">
            <list string="Execuções de Automação" create="0"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'waiting'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="automation_id"/>
                <field name="version_id"/>
                <field name="record_name"/>
                <field name="current_node_name"/>
                <field name="wait_type"/>
                <field name="next_run_at"/>
                <field name="started_at"/>
                <field name="retry_count"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('queued', 'running')"
                       decoration-warning="state == 'waiting'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="last_error" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_mf_automation_execution_form" model="ir.ui.view">
        <field name="name">mf.automation.execution.form</field>
        <field name="model">mf.automation.execution</field>
        <field name="arch" type="xml">
            <form string="Execução de Automação" create="0">
                <header>
                    <button name="action_retry_execution" type="object" string="Reprocessar" icon="fa-refresh" class="btn-primary"
                            groups="maisfibra_automacao.group_automacao_admin"
                            invisible="state not in ('failed', 'queued', 'waiting')"/>
                    <button name="action_cancel_execution" type="object" string="Cancelar Execução" icon="fa-ban" class="btn-secondary"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <strong>Falha registrada:</strong> <field name="last_error" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Execução">
                            <field name="automation_id" readonly="1"/>
                            <field name="version_id" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="record_name" readonly="1"/>
                        </group>
                        <group string="Estado &amp; Espera">
                            <field name="current_node_name" readonly="1"/>
                            <field name="wait_type" readonly="1"/>
                            <field name="wait_until" readonly="1"/>
                            <field name="timeout_at" readonly="1"/>
                            <field name="next_run_at" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="exit_reason" readonly="1" invisible="not exit_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Histórico Cronológico de Ações" name="steps">
                            <field name="step_log_ids" readonly="1">
                                <list>
                                    <field name="executed_at"/>
                                    <field name="node_name"/>
                                    <field name="node_type"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'ok'"
                                           decoration-warning="status in ('wait', 'retry')"
                                           decoration-danger="status == 'error'"/>
                                    <field name="branch_taken"/>
                                    <field name="attempt"/>
                                    <field name="duration_ms"/>
                                    <field name="message"/>
                                    <field name="idempotency_key" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Payload Sanitizado" name="payload">
                            <field name="payload_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mf_automation_step_log_list" model="ir.ui.view">
        <field name="name">mf.automation.step.log.list</field>
        <field name="model">mf.automation.step.log</field>
        <field name="arch" type="xml">
            <list string="Logs de Auditoria das Automações" create="0" edit="0">
                <field name="executed_at"/>
                <field name="automation_id"/>
                <field name="execution_id"/>
                <field name="node_name"/>
                <field name="node_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ok'"
                       decoration-warning="status in ('wait', 'retry')"
                       decoration-danger="status == 'error'"/>
                <field name="branch_taken"/>
                <field name="attempt"/>
                <field name="duration_ms"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="action_mf_automation_executions" model="ir.actions.act_window">
        <field name="name">Execuções</field>
        <field name="res_model">mf.automation.execution</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_mf_automation_logs" model="ir.actions.act_window">
        <field name="name">Logs de Auditoria</field>
        <field name="res_model">mf.automation.step.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
