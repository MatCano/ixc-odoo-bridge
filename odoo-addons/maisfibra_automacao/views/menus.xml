<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_mf_automation_builder" model="ir.actions.client">
        <field name="name">Construtor Visual de Automações</field>
        <field name="tag">maisfibra_automacao.builder</field>
    </record>

    <record id="action_mf_automation_monitor" model="ir.actions.client">
        <field name="name">Monitoramento de Automações</field>
        <field name="tag">maisfibra_automacao.monitor</field>
    </record>

    <!-- Aplicativo raiz no App Switcher -->
    <menuitem id="menu_mf_automacao_app_root"
              name="Automação CRM"
              web_icon="maisfibra_automacao,static/description/icon.png"
              groups="group_automacao_viewer"
              sequence="26"/>

    <menuitem id="menu_mf_auto_fluxos"
              name="Fluxos de Automação"
              parent="menu_mf_automacao_app_root"
              action="action_mf_automations"
              sequence="10"/>

    <menuitem id="menu_mf_auto_monitor"
              name="Monitoramento"
              parent="menu_mf_automacao_app_root"
              action="action_mf_automation_monitor"
              sequence="20"/>

    <menuitem id="menu_mf_auto_execucoes"
              name="Execuções"
              parent="menu_mf_automacao_app_root"
              action="action_mf_automation_executions"
              sequence="30"/>

    <menuitem id="menu_mf_auto_segmentos"
              name="Segmentos"
              parent="menu_mf_automacao_app_root"
              action="action_mf_automation_segments"
              sequence="40"/>

    <menuitem id="menu_mf_auto_logs"
              name="Logs de Auditoria"
              parent="menu_mf_automacao_app_root"
              action="action_mf_automation_logs"
              sequence="50"/>

    <!-- Atalho integrado dentro do app CRM -->
    <menuitem id="menu_crm_mf_automacao"
              name="Automações"
              parent="crm.crm_menu_root"
              action="action_mf_automations"
              groups="group_automacao_viewer"
              sequence="28"/>
</odoo>
