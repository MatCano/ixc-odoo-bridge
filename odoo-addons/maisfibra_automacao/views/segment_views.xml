<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mf_automation_segment_list" model="ir.ui.view">
        <field name="name">mf.automation.segment.list</field>
        <field name="model">mf.automation.segment</field>
        <field name="arch" type="xml">
            <list string="Segmentos de CRM">
                <field name="name"/>
                <field name="model_name"/>
                <field name="member_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_mf_automation_segment_form" model="ir.ui.view">
        <field name="name">mf.automation.segment.form</field>
        <field name="model">mf.automation.segment</field>
        <field name="arch" type="xml">
            <form string="Segmento de CRM">
                <header>
                    <button name="action_preview_members" type="object" string="Visualizar Registros Elegíveis" icon="fa-users" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ex.: Leads Quentes com Telefone"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="member_count"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <group string="Regras de Segmentação (AND / OR em JSON)">
                        <field name="rules_json" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mf_automation_segments" model="ir.actions.act_window">
        <field name="name">Segmentos e Listas</field>
        <field name="res_model">mf.automation.segment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
